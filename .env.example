# ========================================================
# VPHS SERVICES PVT. LTD. - ERP ENVIRONMENT CONFIGURATION
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL or SQLite fallback)
# For PostgreSQL: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vphs_erp?schema=public"
# For Local Dev File DB: DATABASE_URL="file:./dev.db"
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_SECRET=vphs_erp_super_secure_jwt_secret_key_2026_production
JWT_EXPIRES_IN=7d

# File Uploads Directory
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ========================================================
# OPTIONAL EXTERNAL SERVICES (Core ERP operates 100% standalone)
# ========================================================
# EMAIL (SMTP)
ENABLE_EMAIL=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="VPHS ERP <notifications@vphs.in>"

# SMS Gateway
ENABLE_SMS=false
SMS_API_KEY=
SMS_SENDER_ID=VPHSERP

# WHATSAPP Business API
ENABLE_WHATSAPP=false
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# BIOMETRIC Devices API
ENABLE_BIOMETRIC=false
BIOMETRIC_API_URL=
BIOMETRIC_DEVICE_KEY=

# MAP API (Google Maps)
ENABLE_MAPS=false
GOOGLE_MAPS_API_KEY=

# AI Provider
ENABLE_AI=false
AI_API_KEY=
